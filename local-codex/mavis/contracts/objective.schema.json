{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/mavis/objective/v1",
  "title": "Mavis objective",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "objective_id", "blueprint", "requirements", "scope", "acceptance_checks", "state"],
  "properties": {
    "schema_version": {"const": "mavis.objective/v1"},
    "objective_id": {"type": "string", "minLength": 1},
    "blueprint": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "text"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}}, "additionalProperties": true}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "object"},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "unresolved_decisions": {"type": "array", "items": {"type": "string"}},
    "state": {"enum": ["queued", "running", "awaiting verification", "accepted", "needs repair", "escalated", "blocked", "cancelled"]}
  }
}

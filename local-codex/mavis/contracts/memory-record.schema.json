{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/mavis/memory-record/v1",
  "title": "Mavis memory record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "scope", "claim", "source_references", "verification_state", "freshness"],
  "properties": {
    "schema_version": {"const": "mavis.memory-record/v1"},
    "record_id": {"type": "string", "minLength": 1},
    "scope": {"enum": ["project", "global-coding"]},
    "kind": {"enum": ["decision", "failure", "tool-recipe", "history"]},
    "branch": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "record_version": {"type": "integer", "minimum": 1},
    "claim": {"type": "string", "minLength": 1},
    "source_references": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"]}},
    "verification_state": {"enum": ["unverified", "verified", "contested", "stale"]},
    "freshness": {"type": "object", "required": ["observed_at"]},
    "supersedes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"scope": {"const": "project"}}},
     "then": {"required": ["kind", "branch", "revision", "record_version"]}}
  ]
}

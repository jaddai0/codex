{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/mavis/evidence-receipt/v1",
  "title": "Mavis evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "objective_id", "command", "exit_status", "timed_out", "started_at", "finished_at", "raw_output", "changed_revision", "artifact_hashes", "acceptance_check_ids", "producer", "verdict"],
  "properties": {
    "schema_version": {"const": "mavis.evidence-receipt/v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cwd": {"type": "string"},
    "exit_status": {"type": "integer"},
    "timed_out": {"type": "boolean"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "raw_output": {"type": "object", "required": ["path", "sha256", "bytes"]},
    "changed_revision": {"type": ["string", "null"]},
    "artifact_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "acceptance_check_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "producer": {"const": "mavis-host-command/v1"},
    "verdict": {"enum": ["pass", "fail", "incomplete", "uncertain"]}
  }
}

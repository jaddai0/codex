{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/mavis/worker-assignment/v1",
  "title": "Mavis worker assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assignment_id", "objective_id", "requirements", "starting_revision", "owner", "checkout", "allowed_effects", "expected_artifacts", "escalate_when", "state"],
  "properties": {
    "schema_version": {"const": "mavis.worker-assignment/v1"},
    "assignment_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "starting_revision": {"type": "string", "minLength": 7},
    "owner": {"type": "object", "required": ["provider", "model", "harness"]},
    "checkout": {"type": "object", "required": ["path", "owned_paths"]},
    "allowed_effects": {"type": "array", "items": {"type": "string"}},
    "forbidden_effects": {"type": "array", "items": {"type": "string"}},
    "expected_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_commands": {"type": "array", "items": {"type": "string"}},
    "escalate_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "state": {"enum": ["queued", "running", "awaiting verification", "accepted", "needs repair", "escalated", "blocked", "cancelled"]}
  }
}

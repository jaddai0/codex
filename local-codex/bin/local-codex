#!/bin/zsh
set -euo pipefail

script_dir=${0:A:h}
share_dir=${LOCAL_CODEX_SHARE_DIR:-${HOME}/.local/share/local-codex}
runtime_home=${LOCAL_CODEX_HOME:-${HOME}/.local-codex}
base_url=${OMLX_BASE_URL:-http://127.0.0.1:8001/v1}
core_binary=${LOCAL_CODEX_BIN:-${share_dir}/local-codex-core}
model_args=()
gateway_env_args=()

if [[ -n ${LOCAL_CODEX_MODEL:-} ]]; then
  model_args=(--model "$LOCAL_CODEX_MODEL")
fi
gateway_env_file=${MAVIS_GATEWAY_ENV_FILE:-${HOME}/Dev-Projects/env.env}
if [[ -f "$gateway_env_file" ]]; then
  gateway_env_args=(--gateway-env-file "$gateway_env_file")
elif [[ -n ${MAVIS_GATEWAY_ENV_FILE:-} ]]; then
  print -u2 "mavis: configured gateway environment file is unavailable"
  exit 2
fi

case "${1:-}" in
  login|logout|cloud|cloud-tasks|update|app|remote-control)
    print -u2 "mavis: '${1}' is unavailable in the oMLX-only harness"
    exit 2
    ;;
esac

for argument in "$@"; do
  case "$argument" in
    --remote|--use-agent-identity-auth|model_provider=*|*model_provider=openai*)
      print -u2 "mavis: remote/OpenAI provider overrides are disabled"
      exit 2
      ;;
  esac
done

if [[ ! -x "$core_binary" ]]; then
  print -u2 "mavis: core binary not found at $core_binary"
  exit 127
fi

export MAVIS_HOME=${MAVIS_HOME:-${HOME}/.local-codex/mavis-service}
if [[ "$MAVIS_HOME" != /* ]]; then
  print -u2 "mavis: MAVIS_HOME must be an absolute path"
  exit 2
fi

profile_model=$(python3 "$share_dir/prepare_runtime.py" \
  --mavis-home "$MAVIS_HOME" --resolve-model "${model_args[@]}")
if [[ -f "$MAVIS_HOME/profiles/main/active.json" ]]; then
  python3 "$share_dir/launch_core.py" --check-args -- "$@"
fi

PYTHONPATH="${share_dir}${PYTHONPATH:+:${PYTHONPATH}}" \
python3 -m mavis runtime ensure \
  --endpoint "$base_url" \
  --iris-endpoint "${IRIS_OMLX_BASE_URL:-http://127.0.0.1:8000/v1}" \
  --model "$profile_model" \
  --model-dir "${MAVIS_MODEL_DIR:-${HOME}/models/vlms}" \
  --omlx-binary "${MAVIS_OMLX_BIN:-${HOME}/.venvs/omlx-dev/bin/omlx}" >/dev/null

launch_receipt=$(python3 "$share_dir/prepare_runtime.py" \
  --home "$runtime_home" \
  --mavis-home "$MAVIS_HOME" \
  --print-receipt \
  --base-url "$base_url" \
  --persona-template "$share_dir/persona.toml" \
  --instructions-template "$share_dir/base-instructions.md" \
  --gateway-root "${MAVIS_GATEWAY_ROOT:-${HOME}/Dev-Projects/ai-skills-dev-mavis-gateway/marketplace/plugins/model-gateway}" \
  "${gateway_env_args[@]}" \
  --model "$profile_model")

export CODEX_HOME="$runtime_home"
export MAVIS_PRECOMPACT_REQUIRED=1
export MAVIS_RAW_OUTPUT_REQUIRED=1
export PYTHONPATH="${share_dir}${PYTHONPATH:+:${PYTHONPATH}}"
if [[ -n "$launch_receipt" ]]; then
  exec python3 "$share_dir/launch_core.py" --receipt "$launch_receipt" -- "$core_binary" "$@"
fi
exec "$core_binary" "$@"
